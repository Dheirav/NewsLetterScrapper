# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL + pgvector connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelligence_db

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Base URL for your local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Chat model used for knowledge generation (executive summary, implications, etc.)
OLLAMA_LLM_MODEL=llama3.2

# Embedding model — nomic-embed-text produces 768-dimensional vectors
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Email delivery ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password   # Gmail: use a 16-char App Password, not your login password

# Single recipient (backward-compatible)
RECIPIENT_EMAIL=your-email@gmail.com

# Multiple recipients — comma-separated. Both fields are merged and deduplicated.
# Each recipient receives their own individual email (others are not visible).
# RECIPIENT_EMAILS=alice@example.com,bob@example.com

EMAIL_FROM_NAME=Intelligence Briefing

# Test mode: run_pipeline.py --test / send_newsletter.py --test sends ONLY to this
# address and does NOT mark the newsletter as sent, so a real send can follow.
TEST_EMAIL=your-email@gmail.com

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Number of recent days of reading events used to build the user profile
PROFILE_WINDOW_DAYS=30

# Title similarity above which two articles in the SAME batch are the same story
DEDUP_TITLE_THRESHOLD=0.85

# Embedding similarity above which a new article counts as a republication of
# one already stored, and is excluded from clustering. This is the stage that
# catches a story reappearing the next day under a different URL.
#
# Measured on 13,836 real articles: republished and syndicated copies score
# 0.99-1.00, whereas two independent outlets covering the same event score
# around 0.96. Do not lower this past ~0.97 — multi-source coverage is the
# signal clustering exists to find, and collapsing it makes stories look less
# corroborated than they are.
DEDUP_SEMANTIC_THRESHOLD=0.985

# How far back to look for the earlier original
DEDUP_LOOKBACK_DAYS=7

# ─── Public links & unsubscribe ───────────────────────────────────────────────
# Base URL recipients will actually reach. Used to build the one-click
# unsubscribe link and the "Read full briefing online" link inside every email.
# Leaving this at localhost ships dead links to your entire recipient list —
# in production the app refuses to start rather than send them.
PUBLIC_URL=http://localhost:8000

# HMAC key for signing unsubscribe tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it separate from SMTP_PASSWORD: unsubscribe links live in recipients'
# inboxes indefinitely, and signing with the mail password means rotating that
# password silently invalidates every link you have ever sent.
UNSUBSCRIBE_SECRET=

# ─── Security ─────────────────────────────────────────────────────────────────
# When set, /api/graph/* (the destructive CRUD surface) requires this key in an
# X-API-Key header. Leave empty for local-only use. Set it before exposing the
# server through ngrok / Cloudflare Tunnel — those routes can delete your data.
API_KEY=

# Browser origins allowed to call the API, as a JSON array.
# ALLOWED_ORIGINS=["https://briefing.example.com"]

# ─── Pipeline tuning ──────────────────────────────────────────────────────────
# Max articles pulled from each RSS feed per run
FEED_MAX_PER_SOURCE=20

# Max concurrent HTTP requests while scraping full article text
SCRAPE_CONCURRENCY=25

# Articles embedded per concurrent batch
EMBED_BATCH_SIZE=10

# Scraped content shorter than this is flagged content_quality=low (paywall/JS)
MIN_CONTENT_LENGTH=300

# Minimum articles in a cluster before it qualifies for knowledge generation
MIN_CLUSTER_ARTICLES=2

# Cap on clusters that get a knowledge story per run (top N by article count)
MAX_KNOWLEDGE_CLUSTERS=20

# ─── Observability & retention ────────────────────────────────────────────────
# Set to "json" to emit structured log lines instead of human-readable text
LOG_FORMAT=text

# Retention is tiered, because articles and stories cost very different amounts
# to keep. Articles carry the raw text and a 768-dim embedding each and are
# nearly all of the disk usage; stories are the few-KB output the pipeline
# exists to produce and are worth keeping much longer.
#
# ARCHIVE_KEEP_DAYS is the legacy name and seeds the article window when
# ARCHIVE_KEEP_ARTICLES_DAYS is not set.
ARCHIVE_KEEP_ARTICLES_DAYS=90
ARCHIVE_KEEP_STORIES_DAYS=365
